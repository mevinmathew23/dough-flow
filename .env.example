# Copy this file to .env and fill in values. .env is gitignored and never committed.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=doughflow
POSTGRES_PASSWORD=doughflow_dev
POSTGRES_DB=doughflow

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM Category Classification ───────────────────────────────────────────────
# Set LLM_ENABLED=true to classify unmatched CSV transaction categories with AI.
#
# Option A — Groq (recommended, free tier, fast):
#   Get a free API key at console.groq.com
LLM_ENABLED=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=your-groq-api-key-here
#
# Option B — Local Ollama (native app required for GPU acceleration on Mac):
#   Install from ollama.com, then: LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen3.5:0.8b  LLM_API_KEY=ollama
